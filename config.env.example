# Copiá este archivo a .env y completá los valores reales.
# NUNCA subas el archivo .env a git (ya está en .gitignore).

# Panel > Project Settings > Data API, en el proyecto Supabase "panel-campana-soja"
SUPABASE_URL=https://zjfvmaqmgcvwfheenkhu.supabase.co

# Panel > Project Settings > API Keys > clave "publishable" (o la "anon" legacy)
SUPABASE_ANON_KEY=

# Panel > Project Settings > API Keys > clave "service_role" (secreta — nunca al navegador)
SUPABASE_SERVICE_ROLE_KEY=

# Cualquier cadena larga y aleatoria, usada para firmar la cookie de sesión
SESSION_SECRET=

# Puerto local (Render lo define solo en producción)
PORT=3000
